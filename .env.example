# NEXT_PUBLIC_SUPABASE_URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — Supabase Dashboard → Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_DB_URL — Supabase Dashboard → Connect → Session pooler connection string
# (solo para correr migraciones locales; la app en runtime no la usa)
SUPABASE_DB_URL=
